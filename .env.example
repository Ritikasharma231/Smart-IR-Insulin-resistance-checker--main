# === ML API (FastAPI) ===
GROQ_API_KEY=your_groq_api_key_here
REACT_APP_API_URL=http://127.0.0.1:8000

# === Patient database API (SQLite) ===
DATA_PORT=3001
NODE_ENV=development

# JWT signing key — use a long random value (never commit the real secret)
# Generate: openssl rand -base64 48
JWT_SECRET=

# === Admin (provisioned once at server startup — like corporate secrets injection) ===
# Use your organization's admin mailbox and a strong password from your password manager.
# Requirements: 12+ chars, upper, lower, number, special character.
ADMIN_EMAIL=
ADMIN_PASSWORD=
