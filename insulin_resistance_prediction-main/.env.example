# ⚠️ SECURITY WARNING: Never commit this file or your API keys to GitHub!
# This is a template. Copy to .env and fill in your actual values for local development.
# For production, set environment variables on your cloud platform (Render, Railway, etc.)

# REQUIRED: Groq API Key for LLM-powered explanations
# Get your key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Environment mode: 'development' or 'production'
# Production enables JSON structured logging
ENVIRONMENT=development

# Enable/disable RAG (Retrieval Augmented Generation) for medical context
# Note: RAG requires downloading embedding models (~400MB on first load)
# Disable on limited cloud resources (Render free tier has 512MB RAM)
ENABLE_RAG=true

# CORS Origins: comma-separated list of allowed frontend URLs
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://sgt-university.co.in,https://project-ryvfu.vercel.app

# Optional: Cloud deployment URL (automatically added to CORS)
# Example: https://your-app.up.railway.app or https://your-app.onrender.com
CLOUD_URL=
